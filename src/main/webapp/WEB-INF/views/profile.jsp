<%@ include file="_header.jspf" %><h1>Profile</h1><section class="panel narrow"><form method="post" action="${pageContext.request.contextPath}/member/profile"><label>Name<input name="name" required value="<c:out value='${profile.name}'/>"></label><label>Email<input name="email" type="email" required value="<c:out value='${profile.email}'/>"></label><label>New password <span class="muted">(leave blank to keep current)</span><input name="password" type="password" minlength="8" autocomplete="new-password"></label><button class="button primary">Save profile</button></form></section><%@ include file="_footer.jspf" %>
