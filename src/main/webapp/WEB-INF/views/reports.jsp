<%@ include file="_header.jspf" %><h1>Inventory reports</h1><div class="cards"><div class="card"><span>Book titles</span><strong>${summary.totalBooks}</strong></div><div class="card"><span>Available copies</span><strong>${summary.availableCopies}</strong></div><div class="card"><span>Borrowed</span><strong>${summary.borrowedBooks}</strong></div><div class="card"><span>Overdue</span><strong>${summary.overdueBooks}</strong></div><div class="card"><span>Members</span><strong>${summary.totalMembers}</strong></div><div class="card"><span>Transactions</span><strong>${summary.totalTransactions}</strong></div></div><div class="grid two"><section class="panel"><h2>Most borrowed titles</h2><table><thead><tr><th>Title</th><th>Loans</th></tr></thead><tbody><c:forEach items="${mostBorrowed}" var="x"><tr><td><c:out value='${x.title}'/></td><td>${x.borrow_count}</td></tr></c:forEach></tbody></table></section><section class="panel"><h2>Genre distribution</h2><div class="bars"><c:forEach items="${genres}" var="x"><div class="bar-row"><span><c:out value='${x.genre}'/></span><div class="bar"><i style="width:${x.title_count gt 10 ? 100 : x.title_count * 10}%"></i></div><b>${x.title_count}</b></div></c:forEach></div></section><section class="panel"><h2>Monthly borrowing</h2><table><thead><tr><th>Month</th><th>Loans</th></tr></thead><tbody><c:forEach items="${borrowing}" var="x"><tr><td>${x.month}</td><td>${x.total}</td></tr></c:forEach></tbody></table></section><section class="panel"><h2>Monthly returns</h2><table><thead><tr><th>Month</th><th>Returns</th></tr></thead><tbody><c:forEach items="${returns}" var="x"><tr><td>${x.month}</td><td>${x.total}</td></tr></c:forEach></tbody></table></section></div><%@ include file="_footer.jspf" %>
