<%@ include file="_header.jspf" %><h1>Transactions</h1><form class="inline-form" method="get"><label>Status<select name="status"><option value="">All</option><option>BORROWED</option><option>OVERDUE</option><option>RETURNED</option></select></label><button class="button">Filter</button></form><section class="panel"><table><thead><tr><th>Book</th><th>Member</th><th>Borrowed</th><th>Due</th><th>Returned</th><th>Status</th></tr></thead><tbody><c:forEach items="${transactions}" var="t"><tr><td><c:out value='${t.bookTitle}'/></td><td><c:out value='${t.memberName}'/></td><td>${t.borrowDate}</td><td>${t.dueDate}</td><td>${t.returnDate}</td><td><span class="pill">${t.status}</span></td></tr></c:forEach></tbody></table></section><%@ include file="_footer.jspf" %>
