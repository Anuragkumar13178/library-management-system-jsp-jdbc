<%@ include file="_header.jspf" %><h1>Send library announcement</h1><section class="panel narrow"><form method="post"><label>Recipient<select name="memberId"><option value="">All active members</option><c:forEach items="${members}" var="m"><option value="${m.id}"><c:out value='${m.name}'/> · <c:out value='${m.membershipId}'/></option></c:forEach></select></label><label>Title<input name="title" required maxlength="180"></label><label>Message<textarea name="message" required rows="5"></textarea></label><button class="button primary">Send notification</button></form></section><%@ include file="_footer.jspf" %>
