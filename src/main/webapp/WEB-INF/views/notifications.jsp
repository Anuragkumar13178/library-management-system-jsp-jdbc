<%@ include file="_header.jspf" %><h1>Notifications <span class="pill">${unread} unread</span></h1><section class="panel"><c:forEach items="${notifications}" var="n"><article class="notice ${n.read?'':'unread'}"><div><span class="eyebrow"><c:out value='${n.type}'/> · ${n.createdAt}</span><h3><c:out value='${n.title}'/></h3><p><c:out value='${n.message}'/></p></div><c:if test="${not n.read}"><form method="post"><input type="hidden" name="notificationId" value="${n.id}"><button class="button small-button">Mark read</button></form></c:if></article></c:forEach></section><%@ include file="_footer.jspf" %>
