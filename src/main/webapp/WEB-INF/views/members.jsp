<%@ include file="_header.jspf" %><h1>Member management</h1><section class="panel"><h2>Create member</h2><form class="form-grid" method="post" action="${pageContext.request.contextPath}/librarian/members"><label>Name<input name="name" required></label><label>Email<input type="email" name="email" required></label><label>Membership ID<input name="membershipId" required></label><label>Temporary password<input type="password" name="password" required minlength="8"></label><button class="button primary">Create member</button></form></section><section class="panel"><form method="get" action="${pageContext.request.contextPath}/librarian/members" class="inline-form"><input name="q" placeholder="Name, email or membership ID"><button class="button">Search members</button></form><table><thead><tr><th>Membership</th><th>Name</th><th>Email</th><th>Status</th><th>Edit or deactivate</th></tr></thead><tbody><c:forEach items="${members}" var="m"><tr><td colspan="4"><form class="form-grid" method="post" action="${pageContext.request.contextPath}/librarian/members"><input type="hidden" name="id" value="${m.id}"><label>Membership ID<input name="membershipId" required value="<c:out value='${m.membershipId}'/>"></label><label>Name<input name="name" required value="<c:out value='${m.name}'/>"></label><label>Email<input name="email" type="email" required value="<c:out value='${m.email}'/>"></label><label>Status<input readonly value="${m.status}"></label><button class="button small-button">Save member</button></form></td><td><form method="post" action="${pageContext.request.contextPath}/librarian/members"><input type="hidden" name="action" value="deactivate"><input type="hidden" name="id" value="${m.id}"><button class="button danger small-button">Deactivate</button></form></td></tr></c:forEach></tbody></table></section><%@ include file="_footer.jspf" %>
