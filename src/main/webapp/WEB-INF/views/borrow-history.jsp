<%@ include file="_header.jspf" %><h1>Borrowing history</h1><p class="muted">Current loans can be returned here. A member may return only their own active loan.</p><section class="panel"><table><thead><tr><th>Book</th><th>Issue date</th><th>Due date</th><th>Return date</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${history}" var="t"><tr><td><c:out value='${t.bookTitle}'/></td><td>${t.borrowDate}</td><td>${t.dueDate}</td><td>${t.returnDate}</td><td><span class="pill">${t.status}</span><c:if test="${(t.status eq 'BORROWED' or t.status eq 'OVERDUE') and t.dueDate lt today}"> · Overdue</c:if></td><td><c:if test="${t.status eq 'BORROWED' or t.status eq 'OVERDUE'}"><form method="post" action="${pageContext.request.contextPath}/member/return"><input type="hidden" name="transactionId" value="${t.id}"><button class="button small-button">Return</button></form></c:if></td></tr></c:forEach></tbody></table></section><%@ include file="_footer.jspf" %>
