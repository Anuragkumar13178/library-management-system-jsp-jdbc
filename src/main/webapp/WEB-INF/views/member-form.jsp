<%@ include file="_header.jspf" %><h1>${empty member?'Create a member':'Edit member'}</h1><section class="panel narrow"><form method="post" action="${pageContext.request.contextPath}/librarian/members"><input type="hidden" name="id" value="${member.id}"><label>Name<input name="name" required value="<c:out value='${member.name}'/>"></label><label>Email<input name="email" type="email" required value="<c:out value='${member.email}'/>"></label><label>Membership ID<input name="membershipId" required value="<c:out value='${member.membershipId}'/>"></label><c:if test="${empty member}"><label>Initial password<input name="password" type="password" required minlength="8"></label></c:if><button class="button primary">Save member</button></form></section><a href="${pageContext.request.contextPath}/librarian/members">Back to members</a><%@ include file="_footer.jspf" %>
