<%@ include file="_header.jspf" %><div class="panel-heading"><div><p class="eyebrow">CATALOG</p><h1>Book management</h1></div><a href="${pageContext.request.contextPath}/librarian/books">New book</a></div><section class="panel"><h2>${empty book?'Add a book':'Edit book'}</h2><form class="form-grid" method="post" action="${pageContext.request.contextPath}/librarian/books"><input type="hidden" name="id" value="${book.id}"><label>Title<input name="title" required value="<c:out value='${book.title}'/>"></label><label>Author<input name="author" required value="<c:out value='${book.author}'/>"></label><label>ISBN<input name="isbn" required value="<c:out value='${book.isbn}'/>"></label><label>Genre<input name="genre" required value="<c:out value='${book.genre}'/>"></label><label>Publisher<input name="publisher" value="<c:out value='${book.publisher}'/>"></label><label>Publication year<input type="number" name="publicationYear" value="${book.publicationYear}"></label><label>Total quantity<input type="number" min="1" name="totalQuantity" required value="${empty book?1:book.totalQuantity}"></label><label>Available quantity<input type="number" min="0" name="availableQuantity" required value="${empty book?1:book.availableQuantity}"></label><button class="button primary">Save book</button></form></section><section class="panel"><h2>Catalog inventory</h2><%@ include file="_book-table.jspf" %><table><tbody><c:forEach items="${books}" var="b"><tr><td><form method="post" action="${pageContext.request.contextPath}/librarian/books"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${b.id}"><button class="button danger small-button">Delete <c:out value="${b.title}"/></button></form></td></tr></c:forEach></tbody></table></section><%@ include file="_footer.jspf" %>
