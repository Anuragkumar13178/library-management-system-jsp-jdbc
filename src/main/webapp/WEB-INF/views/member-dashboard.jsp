<%@ include file="_header.jspf" %><h1>Hello, <c:out value="${sessionScope.name}"/></h1><p class="muted">Your library at a glance.</p><div class="cards"><div class="card"><span>Currently borrowed</span><strong><c:out value="${currentBorrowed}"/></strong></div><div class="card"><span>Unread notices</span><strong><c:out value="${unread}"/></strong></div><div class="card"><span>Searches saved</span><strong><c:out value="${searches.size()}"/></strong></div></div><div class="grid two"><section class="panel"><div class="panel-heading"><h2>Find a book</h2><a href="${pageContext.request.contextPath}/member/search-history">Search history →</a></div><form class="form-grid" method="get" action="${pageContext.request.contextPath}/member/search"><label>Title<input name="title" placeholder="e.g. Java"></label><label>Author<input name="author"></label><label>Genre<input name="genre"></label><button class="button primary">Search catalog</button></form></section><section class="panel"><div class="panel-heading"><h2>Account</h2></div><p><a href="${pageContext.request.contextPath}/member/history">Borrowing history and returns</a></p><p><a href="${pageContext.request.contextPath}/member/profile">Profile settings</a></p><p><a href="${pageContext.request.contextPath}/member/preferences">Notification preferences</a></p><p><a href="${pageContext.request.contextPath}/member/notifications">Notifications (<c:out value="${unread}"/> unread)</a></p></section></div><section class="panel"><h2>Recent searches</h2><table><thead><tr><th>Search</th><th>Title</th><th>Author</th><th>Genre</th><th>When</th></tr></thead><tbody><c:forEach items="${searches}" var="x"><tr><td><c:out value="${x.searchText}"/></td><td><c:out value="${x.title}"/></td><td><c:out value="${x.author}"/></td><td><c:out value="${x.genre}"/></td><td><c:out value="${x.searchedAt}"/></td></tr></c:forEach></tbody></table></section><%@ include file="_footer.jspf" %>
