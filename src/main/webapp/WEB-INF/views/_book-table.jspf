<table><thead><tr><th>Title</th><th>Author</th><th>Genre</th><th>ISBN</th><th>Available</th><th>Action</th></tr></thead><tbody><c:forEach items="${books}" var="b"><tr><td><strong><c:out value="${b.title}"/></strong><div class="muted small"><c:out value="${b.publisher}"/> · <c:out value="${b.publicationYear}"/></div></td><td><c:out value="${b.author}"/></td><td><c:out value="${b.genre}"/></td><td><c:out value="${b.isbn}"/></td><td><span class="pill"><c:out value="${b.availableQuantity}"/> / <c:out value="${b.totalQuantity}"/></span></td><td><c:if test="${sessionScope.role eq 'MEMBER'}"><form method="post" action="${pageContext.request.contextPath}/member/borrow"><input type="hidden" name="bookId" value="${b.id}"><button class="button small-button" ${b.availableQuantity lt 1?'disabled':''}>Borrow</button></form></c:if><c:if test="${sessionScope.role eq 'LIBRARIAN'}"><a href="${pageContext.request.contextPath}/librarian/book-form?id=${b.id}">Edit</a></c:if></td></tr></c:forEach></tbody></table>

