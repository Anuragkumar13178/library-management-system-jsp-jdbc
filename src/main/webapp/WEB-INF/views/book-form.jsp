<%@ include file="_header.jspf" %><h1>${empty book?'Add a book':'Edit book'}</h1><section class="panel narrow"><form class="form-grid" method="post" action="${pageContext.request.contextPath}/librarian/books"><input type="hidden" name="id" value="${book.id}"><label>Title<input name="title" required value="<c:out value='${book.title}'/>"></label><label>Author<input name="author" required value="<c:out value='${book.author}'/>"></label><label>ISBN<input name="isbn" required value="<c:out value='${book.isbn}'/>"></label><label>Genre<input name="genre" required value="<c:out value='${book.genre}'/>"></label><label>Publisher<input name="publisher" value="<c:out value='${book.publisher}'/>"></label><label>Publication year<input type="number" name="publicationYear" value="${book.publicationYear}"></label><label>Total quantity<input type="number" min="1" name="totalQuantity" required value="${empty book?1:book.totalQuantity}"></label><label>Available quantity<input type="number" min="0" name="availableQuantity" required value="${empty book?1:book.availableQuantity}"><span class="muted small">Must include all currently borrowed copies and cannot exceed total quantity.</span></label><button class="button primary">Save book</button></form></section><a href="${pageContext.request.contextPath}/librarian/books">Back to catalog</a><%@ include file="_footer.jspf" %>
